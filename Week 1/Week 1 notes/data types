# Data Types
# Every value in Python has a data type. Python figures out the data type automatically. 
# This is called dynamic typing.

# Common Data Types:
# 1. String (str) - text enclosed in quotes (e.g., "Hello", 'World')
# 2. Integer (int) - whole numbers (e.g., 1, 42, -5)
# 3. Float (float) - decimal numbers (e.g., 3.14, -0.001)
# 4. Boolean (bool) - True or False values

# You can check the data type of a value using the type() function.
print(type(name))        # Output: <class 'str'>
print(type(age))         # Output: <class 'int'>
print(type(gpa))         # Output: <class 'float'>
print(type(is_student))  # Output: <class 'bool'>

# Sneaky data types
print(type(10 /2))     # Output: <class 'float'> - division always results in a float
print(type("42"))    # Output: <class 'str'> - even though it looks like a number, it's a string because 
#                                              it's in quotes.
